# Copia este archivo a .env para docker compose.
# Secreto HMAC compartido por el user-service (firma) y el gateway (valida). Minimo 32 caracteres.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-2026
# Origenes que el gateway acepta por CORS (separados por coma; admite comodines como http://localhost:*).
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
