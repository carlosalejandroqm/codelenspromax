server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Mismo limite que el source-service para los .zip.
  client_max_body_size 200m;

  # La API va por el mismo origen que la SPA, asi que no hace falta CORS.
  location /api/ {
    proxy_pass ${GATEWAY_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Rutas del router de Angular (/history, /reports/:id...).
  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(js|css|ico|png|svg|woff2?)$ {
    expires 7d;
    add_header Cache-Control "public";
  }
}
